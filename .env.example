# See .env.example for required variables

# Supabase (client-safe keys)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase service role (server only — DO NOT include in client builds)
SUPABASE_SERVICE_ROLE_KEY=

# RevenueCat
REVENUECAT_API_KEY=

# Sentry
SENTRY_DSN=

# PostHog
POSTHOG_KEY=

# Expo (optional)
EXPO_PUBLIC_USE_MOCK=true
